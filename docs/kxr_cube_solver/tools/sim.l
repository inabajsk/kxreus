;; Replays kxr_cube_solver's own command stream (robot.py) on the kxreus
;; kxrl2l2a6h2m model, with config.l / cubeSolver.l timings, writing frames.
(require :rcb4robots)
(setq *robot* (kxr-create-robot "kxrl2l2a6h2m" :model nil))
(setq *rwr-offset* 11 *lwr-offset* -7)
(defun gripper-angle (arm angle)
  (send *robot* arm :gripper-r :joint-angle angle)
  (send *robot* arm :gripper2-r :joint-angle angle))
(defun init-pose-av ()
  (send *robot* :rarm :shoulder-p :joint-angle -95)
  (send *robot* :larm :shoulder-p :joint-angle -90)
  (send *robot* :larm :shoulder-r :joint-angle -10)
  (send *robot* :rarm :shoulder-y :joint-angle  45)
  (send *robot* :larm :shoulder-y :joint-angle -45)
  (send *robot* :rarm :elbow-p :joint-angle -15)
  (send *robot* :larm :elbow-p :joint-angle -15)
  (send *robot* :rarm :wrist-p :joint-angle  20)
  (send *robot* :larm :wrist-p :joint-angle  15)
  (send *robot* :rarm :wrist-r :joint-angle *rwr-offset*)
  (send *robot* :larm :wrist-r :joint-angle *lwr-offset*)
  (send *robot* :head-neck-p :joint-angle 15)
  (gripper-angle :rarm 30)
  (gripper-angle :larm 30)
  (send *robot* :angle-vector))

;; ---- cube: 56 mm, coloured stickers on each face
(defun make-rubik ()
  (let* ((c (make-cube 56 56 56)) (bs nil)
         (cols (list (list #f(1 0 0) #f(29 0 0) (list 1 56 56))
                     (list #f(1 0.45 0) #f(-29 0 0) (list 1 56 56))
                     (list #f(0 0.6 0.1) #f(0 29 0) (list 56 1 56))
                     (list #f(0 0.2 0.9) #f(0 -29 0) (list 56 1 56))
                     (list #f(1 1 1) #f(0 0 29) (list 56 56 1))
                     (list #f(1 0.9 0) #f(0 0 -29) (list 56 56 1)))))
    (send c :set-color #f(0.1 0.1 0.1))
    (dolist (x cols)
      (let ((p (apply #'make-cube (mapcar #'(lambda (v) (* v 0.92)) (caddr x)))))
        (send p :locate (cadr x))
        (send p :set-color (car x))
        (send c :assoc p) (push p bs)))
    (setf (get c :parts) bs)
    c))
(init-pose-av)
(defun jaxis (j) (let ((a (send j :get-val 'axis)))
  (if (vectorp a) a (case a (:x #f(1 0 0)) (:y #f(0 1 0)) (:z #f(0 0 1)) (:-x #f(-1 0 0)) (:-y #f(0 -1 0)) (:-z #f(0 0 -1))))))
(setq *cube* (make-rubik))
(let* ((pr (send *robot* :rarm :end-coords :worldpos))
       (pl (send *robot* :larm :end-coords :worldpos))
       (wr (send (send (send *robot* :rarm :wrist-r) :child-link) :worldcoords))
       (wl (send (send (send *robot* :larm :wrist-r) :child-link) :worldcoords))
       (xr (normalize-vector (send wr :rotate-vector (jaxis (send *robot* :rarm :wrist-r)))))
       (xl (normalize-vector (send wl :rotate-vector (jaxis (send *robot* :larm :wrist-r)))))
       (z (normalize-vector (v* xr xl)))
       (y (normalize-vector (v* z xr))))
  (send *cube* :newcoords (make-coords :pos (midpoint 0.5 pr pl)
                                       :rot (transpose (matrix xr y z)))))
(setq *held* (list :rarm t :larm t))
(defun hand-link (arm) (send (send *robot* arm :gripper-r) :parent-link))
(defun reattach ()
  ;; cube follows the hand that is holding it; with both holding, it stays
  ;; with whichever wrist is NOT about to turn (set in angle below)
  (dolist (arm '(:rarm :larm)) (send (hand-link arm) :dissoc *cube*))
  (cond ((and (getf *held* :rarm) (not (getf *held* :larm))) (send (hand-link :rarm) :assoc *cube*))
        ((and (getf *held* :larm) (not (getf *held* :rarm))) (send (hand-link :larm) :assoc *cube*))))
(defun getf (pl k) (cadr (memq k pl)))
(defun setf-held (k v) (setf (cadr (memq k *held*)) v))

(make-irtviewer :width 640 :height 480)
(send *irtviewer* :change-background #f(0.93 0.95 0.97))
(send *irtviewer* :draw-origin nil)
(objects (append (list *robot* *cube*) (get *cube* :parts)))
(setq (*irtviewer* . x::left-right-angle) 25 (*irtviewer* . x::up-down-angle) 12)
(send *irtviewer* :look-all (make-bounding-box (list #f(-60 -140 100) #f(180 140 330))))
(setq *frame* 0 *label* "")
(setq *log* (open "frames.txt" :direction :output))
(defun shoot ()
  (send *irtviewer* :draw-objects)
  (x::window-main-one)
  (send *irtviewer* :viewer :viewsurface :write-to-image-file (format nil "frames/f~A.png" (+ 100000 *frame*)))
  (format *log* "~A~%" *label*)
  (incf *frame*))
(defun move-to (av ms)
  (let* ((av0 (send *robot* :angle-vector)) (n (max 1 (round (/ ms 40.0)))))
    (dotimes (i n)
      (send *robot* :angle-vector (midpoint (/ (+ i 1.0) n) av0 av))
      (shoot))))
(defun grasp (arm) (gripper-angle arm 23) (let ((av (send *robot* :angle-vector))) (gripper-angle arm 55) (move-to av 500))
  (setf-held arm t) (reattach))
(defun release (arm) (setf-held arm nil) (reattach)
  (gripper-angle arm 55) (let ((av (send *robot* :angle-vector))) (gripper-angle arm 23) (move-to av 200)))
(defun angle (arm ang)
  (let* ((ang (+ ang (if (eq arm :rarm) *rwr-offset* *lwr-offset*)))
         (wr (send *robot* arm :wrist-r))
         (da (- ang (send wr :joint-angle)))
         (n (round (/ (abs da) 30))) av)
    (when (and (getf *held* :rarm) (getf *held* :larm))
      ;; both holding: this wrist turns a FACE; the cube body stays with the other hand
      (send (hand-link (if (eq arm :rarm) :larm :rarm)) :assoc *cube*))
    (send wr :joint-angle ang)
    (setq av (send *robot* :angle-vector))
    (send wr :joint-angle (- ang da))
    (move-to av (max 40 (* n 200)))
    (reattach)))
(defun init-pose () (move-to (init-pose-av) 1000))
(unix::system "mkdir -p frames")
(with-open-file (f "cmds.txt")
  (let (line)
    (while (setq line (read-line f nil nil))
      (let* ((tab (position #\Tab line)) (ph (subseq line 0 tab)) (c (subseq line (1+ tab))))
        (setq *label* (format nil "~A~C~A" ph #\Tab c))
        (eval (read-from-string c))))))
(dotimes (i 25) (shoot))
(close *log*)
(format t "frames ~A~%" *frame*)
(exit)
