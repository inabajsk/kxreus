(require :rcb4robots)
(setq *robot* (kxr-create-robot "kxrl2l2a6h2m" :model nil))
(setq *rwr-offset* 11 *lwr-offset* -7)
(defun gripper-angle(arm angle)
  (send *robot* arm :gripper-r :joint-angle angle)
  (send *robot* arm :gripper2-r :joint-angle angle))
(defun init-pose()
  (send *robot* :rarm :shoulder-p :joint-angle -95)
  (send *robot* :larm :shoulder-p :joint-angle -90)
  (send *robot* :larm :shoulder-r :joint-angle -10)
  (send *robot* :rarm :shoulder-y :joint-angle  45)
  (send *robot* :larm :shoulder-y :joint-angle -45)
  (send *robot* :rarm :elbow-p :joint-angle -15)
  (send *robot* :larm :elbow-p :joint-angle -15)
  (send *robot* :rarm :wrist-p :joint-angle  20)
  (send *robot* :larm :wrist-p :joint-angle  15)
  (send *robot* :rarm :wrist-r :joint-angle *rwr-offset*)
  (send *robot* :larm :wrist-r :joint-angle *lwr-offset*)
  (send *robot* :head-neck-p :joint-angle 15)
  (gripper-angle :rarm 30)
  (gripper-angle :larm 30))
(print (send-all (send *robot* :joint-list) :name))
(make-irtviewer :width 700 :height 700)
(send *irtviewer* :change-background #f(0.93 0.95 0.97))
(send *irtviewer* :draw-origin nil)
(objects (list *robot*))
(defun snap (f lr ud)
  (setq (*irtviewer* . x::left-right-angle) lr (*irtviewer* . x::up-down-angle) ud)
  (send *irtviewer* :look-all)
  (send *irtviewer* :draw-objects) (x::window-main-one) (send *irtviewer* :draw-objects)
  (send *irtviewer* :viewer :viewsurface :write-to-image-file f))
(snap "neutral.png" 30 15)
(init-pose)
(snap "init.png" 20 15)
(snap "init_front.png" 0 10)
(print (send *robot* :rarm :end-coords :worldpos))
(print (send *robot* :larm :end-coords :worldpos))
(exit)
